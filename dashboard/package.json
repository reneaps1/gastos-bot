{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "generate": "node -e \"process.env.DATABASE_URL ||= 'postgresql://x:x@localhost:0/x'; require('child_process').execSync('prisma generate', {stdio:'inherit'})\"",
    "build": "npm run generate && next build",
    "start": "prisma generate && (prisma migrate resolve --rolled-back 20260617000000_check_constraints || true) && prisma migrate deploy && next start",
    "lint": "eslint",
    "postinstall": "node -e \"process.env.DATABASE_URL && require('child_process').execSync('prisma generate', {stdio:'inherit'})\" || true",
    "cap:dev": "npx cap open ios",
    "cap:sync": "npx cap sync",
    "cap:build": "npm run build && npx cap copy && npx cap sync",
    "cap:release": "npm run build && npx cap sync && cd ios/App && xcodebuild -workspace App.xcworkspace -scheme App -configuration Release archive",
    "cap:assets": "node scripts/generate-assets.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.14",
    "@tailwindcss/postcss": "^4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.10",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "sharp": "^0.35.2"
  }
}
