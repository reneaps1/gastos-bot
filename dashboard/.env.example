# PostgreSQL (misma base de datos que usa el bot)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gastos?schema=public"

# Secreto para firmar la cookie de sesion del login del dashboard.
# Generar uno propio por ambiente, por ejemplo: openssl rand -base64 32
SESSION_SECRET=genera_un_secreto_largo_y_aleatorio

# Token con el que el bot de Telegram aplica los cambios que el usuario
# CONFIRMA (ver dashboard/src/lib/service-auth.ts). Mismo valor en el bot.
# Sin el, el header de servicio no abre nada. openssl rand -hex 32
MILO_SERVICE_TOKEN=

# Chat de Milo en el dashboard: a donde reenvia /api/milo/* (el agente vive en
# el bot, src/agenteWeb.js). Sin default a proposito.
MILO_BOT_URL=https://gastos-bot-csca.onrender.com
