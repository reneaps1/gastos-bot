generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TipoMovimiento {
  Gasto
  Ingreso
  Ahorro
}

// Direccion de un movimiento de ahorro (categoria.tipo === 'Ahorro'): Aporte
// suma al saldo del ahorro/apartado, Retiro resta. monto siempre se guarda
// positivo, asi que direccion es la unica forma de saber el signo. NULL para
// transacciones que no son de ahorro.
enum DireccionAhorro {
  Aporte
  Retiro
}

enum ClasificacionGasto {
  Fijo
  Variable
}

enum EstatusPago {
  Pagado
  Pendiente
}

enum TipoCredito {
  Tarjeta
  CreditoTienda
  Prestamo
  MSI
  LineaCredito
  Informal
  Otro
}

enum EstatusCreditoPago {
  Pendiente
  Pagado
  Vencido
  Cancelado
}

enum TipoPeriodo {
  QUINCENAL
  SEMANAL
  MENSUAL
}

// Disposicion de una linea de Gasto que sigue "Abierta" cuando su quincena ya
// termino: Cumplida (se registro/enlazo la transaccion real), Cancelada (no
// aplico, nunca va a registrarse), Absorbida (se acepta la variacion, gastado
// != presupuestado, sin mas accion). Ver dashboard/src/lib/cierre-quincena.ts.
enum EstadoLineaPresupuesto {
  Abierta
  Cumplida
  Cancelada
  Absorbida
}

model User {
  id            Int      @id @default(autoincrement())
  nombre        String   @unique @db.VarChar(50)
  phoneWhatsapp String?  @unique @map("phone_whatsapp") @db.VarChar(20)
  activo        Boolean  @default(true)
  fechaRegistro DateTime @default(now()) @map("fecha_registro") @db.Timestamptz()

  transacciones          Transaccion[]
  whatsappMsgs           WhatsappMessage[]
  importBatches          ImportBatch[]
  auditLogs              AuditLog[]
  creditos               Credito[]
  comentariosPresupuesto ComentarioPresupuesto[]

  @@map("users")
}

model Categoria {
  id               Int                 @id @default(autoincrement())
  nombre           String              @unique @db.VarChar(50)
  tipo             TipoMovimiento
  clasificacion    ClasificacionGasto?
  ejemplos         String?
  activo           Boolean             @default(true)
  cuentaParaLimite Boolean             @default(true) @map("cuenta_para_limite")

  transacciones Transaccion[]
  presupuestos  Presupuesto[]
  creditoPagos  CreditoPago[]

  @@map("categorias")
}

model MetodoPago {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(30)

  transacciones Transaccion[]

  @@map("metodos_pago")
}

model Quincena {
  id          Int         @id @default(autoincrement())
  codigo      String      @unique @db.VarChar(5)
  fechaInicio DateTime    @map("fecha_inicio") @db.Date
  fechaFin    DateTime    @map("fecha_fin") @db.Date
  tipo        TipoPeriodo @default(QUINCENAL)
  // ingresoReferencia / limiteGastoReferencia: sobreescriben, solo para esta
  // quincena, los valores globales del mismo nombre en Configuracion. NULL
  // (el default) significa "usa el global" — ver lib/referencia.ts (dashboard) resolveReferencia().
  ingresoReferencia     Decimal? @map("ingreso_referencia") @db.Decimal(12, 2)
  limiteGastoReferencia Decimal? @map("limite_gasto_referencia") @db.Decimal(12, 2)
  // NULL = la quincena todavia no se cierra (aunque fechaFin ya haya pasado).
  // Se marca sola desde el endpoint de cierre cuando ya no queda ninguna
  // linea de Gasto "Abierta" pendiente. cerradaPor guarda el username de la
  // sesion (dashboard/src/lib/auth.ts), no un FK a users.
  fechaCierre DateTime? @map("fecha_cierre") @db.Timestamptz()
  cerradaPor  String?   @map("cerrada_por") @db.VarChar(50)

  transacciones        Transaccion[]      @relation("TransaccionImpacto")
  transaccionesConsumo Transaccion[]      @relation("TransaccionConsumo")
  presupuestos         Presupuesto[]
  liquidezSnapshots    LiquidezSnapshot[]
  creditoPagos         CreditoPago[]

  @@map("quincenas")
}

// Ajustes globales de la aplicacion, fila unica (id=1). Ver frecuenciaPagoDefault:
// controla que cadencia se sugiere al agregar un nuevo periodo de pago desde
// Configuracion > Periodos de pago, no cambia el comportamiento de periodos ya
// creados (cada Quincena.tipo es independiente).
//
// ingresoReferencia / limiteGastoReferencia: valores de referencia (nunca una
// restriccion dura) para "cuanto espero ganar" y "cuanto quiero limitar mi
// gasto" en un periodo. Se comparan contra el gasto real que cuenta para el
// limite (ver Categoria.cuentaParaLimite) en Dashboard y Presupuesto.
model Configuracion {
  id                     Int         @id @default(autoincrement())
  frecuenciaPagoDefault  TipoPeriodo @default(QUINCENAL) @map("frecuencia_pago_default")
  ingresoReferencia      Decimal?    @map("ingreso_referencia") @db.Decimal(12, 2)
  limiteGastoReferencia  Decimal?    @map("limite_gasto_referencia") @db.Decimal(12, 2)
  fechaActualizacion     DateTime    @default(now()) @updatedAt @map("fecha_actualizacion") @db.Timestamptz()

  @@map("configuracion")
}

model Cuenta {
  id     Int     @id @default(autoincrement())
  nombre String  @unique @db.VarChar(50)
  tipo   String? @db.VarChar(30)

  creditos Credito[]

  @@map("cuentas")
}

// Sub-cuenta de ahorro (apartado bancario): agrupa aportaciones/retiros de
// categoria "Ahorro" bajo una meta opcional. El saldo se calcula en vivo a
// partir de sus transacciones (Aporte suma, Retiro resta), no se guarda
// columna de saldo. apartadoId NULL en una transaccion significa "ahorro
// general", sin apartado asignado.
model Apartado {
  id            Int      @id @default(autoincrement())
  nombre        String   @unique @db.VarChar(50)
  metaMonto     Decimal? @map("meta_monto") @db.Decimal(12, 2)
  // Icono y color elegidos al crear/editar el apartado (ver
  // @/lib/apartado-icons: APARTADO_ICONS, APARTADO_COLORS). NULL en filas
  // creadas antes de esta feature -- resolveApartadoIcon()/resolveApartadoColor()
  // caen al PiggyBank azul de siempre en ese caso.
  icono         String?  @db.VarChar(30)
  color         String?  @db.VarChar(20)
  activo        Boolean  @default(true)
  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz()

  transacciones Transaccion[]

  @@map("apartados")
}

model Transaccion {
  id                  Int                 @id @default(autoincrement())
  fecha               DateTime            @db.Date
  quincenaId          Int                 @map("quincena_id")
  quincenaConsumoId   Int?                @map("quincena_consumo_id")
  userId              Int?                @map("user_id")
  descripcion         String              @db.VarChar(200)
  categoriaId         Int                 @map("categoria_id")
  clasificacion       ClasificacionGasto?
  tipo                TipoMovimiento
  // Solo tiene sentido cuando tipo === 'Ahorro' (ver DireccionAhorro). NULL
  // para el resto de transacciones.
  direccion           DireccionAhorro?
  monto               Decimal             @db.Decimal(12, 2)
  metodoPagoId        Int?                @map("metodo_pago_id")
  creditoId           Int?                @map("credito_id")
  presupuestoId       Int?                @map("presupuesto_id")
  // Apartado de ahorro asignado (opcional). NULL = ahorro general / sin
  // apartado. Solo relevante para transacciones de categoria "Ahorro".
  apartadoId          Int?                @map("apartado_id")
  fechaPagoProgramada DateTime?           @map("fecha_pago_programada") @db.Date
  estatus             EstatusPago         @default(Pendiente)
  notas               String?
  source              String?             @default("whatsapp") @db.VarChar(20)
  fechaRegistro       DateTime            @default(now()) @map("fecha_registro") @db.Timestamptz()

  quincena        Quincena    @relation("TransaccionImpacto", fields: [quincenaId], references: [id])
  quincenaConsumo Quincena?   @relation("TransaccionConsumo", fields: [quincenaConsumoId], references: [id])
  user            User?       @relation(fields: [userId], references: [id])
  categoria       Categoria   @relation(fields: [categoriaId], references: [id])
  metodoPago      MetodoPago? @relation(fields: [metodoPagoId], references: [id])
  credito         Credito?    @relation(fields: [creditoId], references: [id])
  presupuesto     Presupuesto? @relation(fields: [presupuestoId], references: [id], onDelete: SetNull)
  apartado        Apartado?   @relation(fields: [apartadoId], references: [id])

  whatsappMsgs WhatsappMessage[]
  creditoPagos CreditoPago[]

  @@index([quincenaId], name: "idx_tx_quincena")
  @@index([quincenaConsumoId], name: "idx_tx_quincena_consumo")
  @@index([categoriaId], name: "idx_tx_categoria")
  @@index([fecha], name: "idx_tx_fecha")
  @@index([tipo], name: "idx_tx_tipo")
  @@index([creditoId], name: "idx_tx_credito")
  @@index([presupuestoId], name: "idx_tx_presupuesto")
  @@index([apartadoId], name: "idx_tx_apartado")
  @@map("transacciones")
}

model Presupuesto {
  id                 Int                 @id @default(autoincrement())
  quincenaId         Int                 @map("quincena_id")
  descripcion        String              @db.VarChar(200)
  categoriaId        Int                 @map("categoria_id")
  clasificacion      ClasificacionGasto?
  tipo               TipoMovimiento
  montoPresupuestado Decimal             @map("monto_presupuestado") @db.Decimal(12, 2)
  notas              String?
  recurrente         Boolean             @default(false)
  frecuencia         String?             @db.VarChar(20)
  recurrenciaGrupoId String?             @map("recurrencia_grupo_id") @db.VarChar(36)
  numOcurrencias     Int?                @map("num_ocurrencias")
  diaCobro           Int?                @map("dia_cobro")
  fechaRegistro      DateTime            @default(now()) @map("fecha_registro") @db.Timestamptz()
  estadoLinea        EstadoLineaPresupuesto @default(Abierta) @map("estado_linea")
  // Presupuesto Modificado (terminologia de presupuesto publico: Original ->
  // Modificado -> Ejercido). NULL = sin revisar, el efectivo es
  // montoPresupuestado. Solo se mueve via traspaso explicito (ver
  // POST /api/presupuestos/[id]/transferir) -- montoPresupuestado (el
  // compromiso original) nunca se toca despues de creado.
  montoRevisado      Decimal?            @map("monto_revisado") @db.Decimal(12, 2)

  quincena      Quincena      @relation(fields: [quincenaId], references: [id])
  categoria     Categoria     @relation(fields: [categoriaId], references: [id])
  creditoPagos  CreditoPago[]
  transacciones Transaccion[]
  comentarios   ComentarioPresupuesto[]

  @@index([quincenaId], name: "idx_presupuesto_quincena")
  @@index([recurrenciaGrupoId], name: "idx_presupuesto_grupo")
  @@map("presupuesto")
}

// Hilo de comentarios de una linea de presupuesto (autor + fecha + texto),
// distinto del campo `notas` de arriba (una sola nota que se sobreescribe,
// sin autor). Pensado para que las dos personas del hogar dejen mensajes tipo
// "ya deposite mi parte" sobre una partida especifica. La sesion de este
// dashboard es un login unico compartido (ver @/lib/auth), no hay forma de
// inferir quien escribe -- el autor se elige a mano en un <select>, igual que
// ya hace Transaccion.userId.
model ComentarioPresupuesto {
  id            Int      @id @default(autoincrement())
  presupuestoId Int      @map("presupuesto_id")
  userId        Int?     @map("user_id")
  texto         String
  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz()

  presupuesto Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id])

  @@index([presupuestoId], name: "idx_comentario_presupuesto")
  @@map("comentarios_presupuesto")
}

model Credito {
  id             Int         @id @default(autoincrement())
  nombre         String      @unique @db.VarChar(100)
  tipoCredito    TipoCredito @default(Otro) @map("tipo_credito")
  acreedor       String      @db.VarChar(100)
  userId         Int?        @map("user_id")
  montoOriginal  Decimal?    @map("monto_original") @db.Decimal(12, 2)
  saldoInicial   Decimal?    @map("saldo_inicial") @db.Decimal(12, 2)
  limiteCredito  Decimal?    @map("limite_credito") @db.Decimal(12, 2)
  diaCorte       Int?        @map("dia_corte")
  diaPago        Int?        @map("dia_pago")
  frecuenciaPago String?     @map("frecuencia_pago") @db.VarChar(20)
  montoPagoFijo  Decimal?    @map("monto_pago_fijo") @db.Decimal(12, 2)
  plazoMeses     Int?        @map("plazo_meses")
  tasaInteres    Decimal?    @map("tasa_interes") @db.Decimal(7, 4)
  cuentaPagoId   Int?        @map("cuenta_pago_id")
  activo         Boolean     @default(true)
  notas          String?
  fechaInicio    DateTime?   @map("fecha_inicio") @db.Date
  fechaRegistro  DateTime    @default(now()) @map("fecha_registro") @db.Timestamptz()

  user          User?         @relation(fields: [userId], references: [id])
  cuentaPago    Cuenta?       @relation(fields: [cuentaPagoId], references: [id])
  transacciones Transaccion[]
  pagos         CreditoPago[]

  @@index([tipoCredito], name: "idx_creditos_tipo")
  @@index([userId], name: "idx_creditos_user")
  @@map("creditos")
}

model CreditoPago {
  id                  Int                @id @default(autoincrement())
  creditoId           Int                @map("credito_id")
  transaccionId       Int?               @map("transaccion_id")
  quincenaId          Int                @map("quincena_id")
  categoriaId         Int                @map("categoria_id")
  presupuestoId       Int?               @map("presupuesto_id")
  numeroPago          Int?               @map("numero_pago")
  totalPagos          Int?               @map("total_pagos")
  fechaPagoProgramada DateTime           @map("fecha_pago_programada") @db.Date
  fechaPagoReal       DateTime?          @map("fecha_pago_real") @db.Date
  montoCapital        Decimal            @default(0) @map("monto_capital") @db.Decimal(12, 2)
  montoInteres        Decimal            @default(0) @map("monto_interes") @db.Decimal(12, 2)
  montoTotal          Decimal            @map("monto_total") @db.Decimal(12, 2)
  estatus             EstatusCreditoPago @default(Pendiente)
  notas               String?
  fechaRegistro       DateTime           @default(now()) @map("fecha_registro") @db.Timestamptz()

  credito     Credito      @relation(fields: [creditoId], references: [id])
  transaccion Transaccion? @relation(fields: [transaccionId], references: [id], onDelete: SetNull)
  quincena    Quincena     @relation(fields: [quincenaId], references: [id])
  categoria   Categoria    @relation(fields: [categoriaId], references: [id])
  presupuesto Presupuesto? @relation(fields: [presupuestoId], references: [id], onDelete: SetNull)

  @@index([creditoId], name: "idx_credito_pagos_credito")
  @@index([quincenaId], name: "idx_credito_pagos_quincena")
  @@index([categoriaId], name: "idx_credito_pagos_categoria")
  @@index([estatus], name: "idx_credito_pagos_estatus")
  @@index([fechaPagoProgramada], name: "idx_credito_pagos_fecha")
  @@map("credito_pagos")
}

model Deuda {
  id            Int       @id @default(autoincrement())
  acreedor      String    @db.VarChar(100)
  deudaOriginal Decimal   @map("deuda_original") @db.Decimal(12, 2)
  abonoMensual  Decimal?  @map("abono_mensual") @db.Decimal(12, 2)
  activo        Boolean   @default(true)
  notas         String?
  fechaInicio   DateTime? @map("fecha_inicio") @db.Date
  fechaRegistro DateTime  @default(now()) @map("fecha_registro") @db.Timestamptz()

  @@map("deudas")
}

model WhatsappMessage {
  id            Int      @id @default(autoincrement())
  waMessageId   String?  @unique @map("wa_message_id") @db.VarChar(100)
  fromNumber    String   @map("from_number") @db.VarChar(20)
  fromName      String?  @map("from_name") @db.VarChar(100)
  userId        Int?     @map("user_id")
  body          String
  tipo          String?  @db.VarChar(20)
  procesado     Boolean  @default(false)
  transaccionId Int?     @map("transaccion_id")
  error         String?
  fechaMensaje  DateTime @map("fecha_mensaje") @db.Timestamptz()
  fechaRegistro DateTime @default(now()) @map("fecha_registro") @db.Timestamptz()

  user        User?        @relation(fields: [userId], references: [id])
  transaccion Transaccion? @relation(fields: [transaccionId], references: [id])

  @@index([fromNumber], name: "idx_wa_from")
  @@index([fechaMensaje], name: "idx_wa_fecha")
  @@index([userId], name: "idx_wa_user")
  @@map("whatsapp_messages")
}

// SIN USO. Quedo de la feature en que el bot preguntaba por WhatsApp a que
// linea de presupuesto asignar un gasto; se retiro porque la asignacion se
// hace a mano desde el dashboard. La tabla se dejo en la base a proposito (no
// se borro con una migracion), asi que el modelo se conserva para que el
// esquema siga reflejando la base: quitarlo dejando la tabla haria que
// `prisma migrate dev` quisiera emitir un DROP por su cuenta. Ningun codigo
// la lee ni la escribe. Si algun dia se retoma la feature, ver el commit
// 83557c3.
model PendingExpense {
  id                Int      @id @default(autoincrement())
  phone             String   @unique @db.VarChar(20)
  userId            Int?     @map("user_id")
  senderName        String?  @map("sender_name") @db.VarChar(100)
  originalMessageId String?  @map("original_message_id") @db.VarChar(100)
  rawText           String   @map("raw_text")
  fecha             DateTime @db.Date
  descripcion       String   @db.VarChar(200)
  monto             Decimal  @db.Decimal(12, 2)
  formaPago         String   @map("forma_pago") @db.VarChar(30)
  metodoPagoId      Int?     @map("metodo_pago_id")
  estatus           EstatusPago
  quincenaId        Int      @map("quincena_id")
  quincenaCodigo    String   @map("quincena_codigo") @db.VarChar(5)
  source            String   @db.VarChar(20)
  opciones          Json
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt         DateTime @map("expires_at") @db.Timestamptz()

  @@map("pending_expenses")
}

model ImportBatch {
  id          Int       @id @default(autoincrement())
  fuente      String    @db.VarChar(30)
  archivo     String?   @db.VarChar(200)
  totalFilas  Int       @default(0) @map("total_filas")
  importadas  Int       @default(0)
  rechazadas  Int       @default(0)
  errores     String?
  estado      String    @default("pendiente") @db.VarChar(20)
  fechaInicio DateTime  @default(now()) @map("fecha_inicio") @db.Timestamptz()
  fechaFin    DateTime? @map("fecha_fin") @db.Timestamptz()
  usuarioId   Int?      @map("usuario_id")

  usuario User? @relation(fields: [usuarioId], references: [id])

  @@map("import_batches")
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  tabla         String   @db.VarChar(50)
  registroId    Int      @map("registro_id")
  operacion     String   @db.VarChar(10)
  campo         String?  @db.VarChar(50)
  valorAnterior String?  @map("valor_anterior")
  valorNuevo    String?  @map("valor_nuevo")
  userId        Int?     @map("user_id")
  source        String?  @db.VarChar(20)
  fecha         DateTime @default(now()) @db.Timestamptz()

  user User? @relation(fields: [userId], references: [id])

  @@index([tabla, registroId], name: "idx_audit_tabla")
  @@index([fecha], name: "idx_audit_fecha")
  @@map("audit_log")
}

model LiquidezSnapshot {
  id            Int      @id @default(autoincrement())
  fechaCorte    DateTime @map("fecha_corte") @db.Timestamptz()
  quincenaId    Int      @map("quincena_id")
  bbva          Decimal  @default(0) @db.Decimal(12, 2)
  banamex       Decimal  @default(0) @db.Decimal(12, 2)
  uala          Decimal  @default(0) @db.Decimal(12, 2)
  ualaInversion Decimal  @default(0) @map("uala_inversion") @db.Decimal(12, 2)
  efectivo      Decimal  @default(0) @db.Decimal(12, 2)
  valesDespensa Decimal  @default(0) @map("vales_despensa") @db.Decimal(12, 2)
  valesGasolina Decimal  @default(0) @map("vales_gasolina") @db.Decimal(12, 2)
  otros         Decimal  @default(0) @db.Decimal(12, 2)
  otrosNota     String?  @map("otros_nota")
  faltaPagar    Decimal  @default(0) @map("falta_pagar") @db.Decimal(12, 2)
  pagosQuincena Decimal  @default(0) @map("pagos_quincena") @db.Decimal(12, 2)
  gastosReales Decimal?  @map("gastos_reales") @db.Decimal(12, 2)
  gastosPronosticados Decimal? @map("gastos_pronosticados") @db.Decimal(12, 2)
  teorico       Decimal? @db.Decimal(12, 2)
  notas         String?
  validado      Boolean  @default(false)
  fechaRegistro DateTime @default(now()) @map("fecha_registro") @db.Timestamptz()

  quincena Quincena @relation(fields: [quincenaId], references: [id])

  @@index([quincenaId], name: "idx_liquidez_quincena")
  @@map("liquidez_snapshots")
}
